---
import BaseLayout from '../layouts/BaseLayout.astro';
import { shops } from '../data/shops';
---
<BaseLayout title="Lino Barbers Website System" description="Shared website system for Lino’s three barber shops." theme="village">
  <main class="section">
    <div class="container">
      <p class="kicker">Starter system</p>
      <h1>Lino’s 3-site barber website system</h1>
      <p class="lede">Three separate shop identities. One shared codebase. Booksy handles booking.</p>
      <div class="grid-4" style="margin-top:32px; grid-template-columns: repeat(3, 1fr);">
        {shops.map((shop) => (
          <a class="card" href={`/${shop.slug}/`}>
            <h2>{shop.name}</h2>
            <p>{shop.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
