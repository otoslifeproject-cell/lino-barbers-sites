---
const { shop } = Astro.props;
const bookHref = shop.booksyUrl ? shop.booksyUrl : '#location';
const primaryTarget = shop.booksyUrl ? '_blank' : '_self';
---
<section class="section" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Services & prices</p>
        <h2 class="section-title">Cuts, fades and tidy finishes</h2>
      </div>
      <a class="button secondary" href={bookHref} target={primaryTarget} rel="noreferrer">{shop.primaryCtaLabel}</a>
    </div>
    <p class="lede">{shop.serviceIntro}</p>
    <div class="grid-4" style="margin-top: 24px;">
      {shop.services.map((service) => (
        <article class="card service-card">
          <div>
            <h3>{service.name}</h3>
            <p>{service.note}</p>
          </div>
          <div class="price">{service.price}</div>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section highlight-section" aria-label={`${shop.name} highlights`}>
  <div class="container highlight-grid">
    {shop.highlights.map((item) => (
      <article class="card highlight-card">
        <p class="kicker">Good to know</p>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </div>
</section>
