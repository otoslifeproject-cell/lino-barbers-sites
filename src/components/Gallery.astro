---
const { shop } = Astro.props;
---
<section class="section gallery-section" id="gallery">
  <div class="container">
    <p class="kicker">Gallery</p>
    <h2 class="section-title">Inside {shop.shortName}</h2>
    <p class="lede">Temporary preview images are being used while Lino gathers final shop photography.</p>
    <div class="gallery-grid">
      {shop.galleryImages.map((image, index) => (
        <figure class="gallery-item">
          <img src={image} alt={`${shop.name} gallery image ${index + 1}`} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>
