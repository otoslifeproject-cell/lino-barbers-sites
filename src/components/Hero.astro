---
const { shop } = Astro.props;
const bookHref = shop.booksyUrl ? shop.booksyUrl : '#location';
const primaryTarget = shop.booksyUrl ? '_blank' : '_self';
const heroBadges = [shop.availabilityLine, ...shop.highlights.slice(0, 2).map((item) => item.title)].filter(Boolean);
const uniqueHeroBadges = [...new Map(heroBadges.map((badge) => [badge.trim().toLowerCase(), badge])).values()];
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="kicker">{shop.kicker}</div>
      <h1>{shop.tagline}</h1>
      <p class="lede">{shop.intro}</p>
      <div class="hero-badges" aria-label="Shop highlights">
        {uniqueHeroBadges.map((badge) => <span>{badge}</span>)}
      </div>
      <div class="hero-actions">
        <a class="button" href={bookHref} target={primaryTarget} rel="noreferrer">{shop.primaryCtaLabel}</a>
        <a class="button secondary" href="#services">View prices</a>
      </div>
    </div>
    <div class="hero-media">
      <img src={shop.heroImage} alt={`${shop.name} shop preview`} />
      <span>{shop.visualLabel}</span>
    </div>
  </div>
</section>
