---
const { shop } = Astro.props;
const phoneHref = shop.phone ? `tel:${shop.phone.replace(/\s+/g, '')}` : '#contact';
const mapsHref = shop.googleMapsUrl && shop.googleMapsUrl !== '#' ? shop.googleMapsUrl : '#contact';
const bookingLine = shop.bookingMode === 'walk-ins-only' ? 'Walk-ins only' : 'Book online or walk in';
---
<section class="section" id="location">
  <div class="container two-col">
    <div class="card contact-card">
      <p class="kicker">Find us</p>
      <h2 class="section-title">Visit {shop.shortName}</h2>
      <p>{shop.address}</p>
      <p class="contact-note"><strong>{bookingLine}</strong></p>
      <div class="contact-actions">
        <a class="button" href={mapsHref} target={mapsHref.startsWith('http') ? '_blank' : '_self'} rel="noreferrer">Open maps</a>
        <a class="button secondary" href={phoneHref}>Call {shop.shortName}</a>
      </div>
    </div>
    <div class="card" id="contact">
      <p class="kicker">Opening hours</p>
      <h2 class="section-title">Plan your visit</h2>
      <div class="hours-list">
        {shop.openingHours.map((row) => (
          <p><strong>{row.day}</strong><span>{row.hours}</span></p>
        ))}
      </div>
    </div>
  </div>
</section>
