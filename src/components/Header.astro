---
const { shop } = Astro.props;
const bookHref = shop.booksyUrl === 'Needs Lino confirmation' ? '#contact' : shop.booksyUrl;
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <span>{shop.name}</span>
    </a>
    <nav class="nav-links">
      <a href="#services">Services</a>
      <a href="#gallery">Gallery</a>
      <a href="#location">Find us</a>
      <a class="button" href={bookHref} target={bookHref.startsWith('http') ? '_blank' : '_self'} rel="noreferrer">Book now</a>
    </nav>
  </div>
</header>
