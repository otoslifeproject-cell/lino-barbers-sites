---
const { shop } = Astro.props;
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={`/${shop.slug}/`}>
      <img src={shop.logo} alt={`${shop.name} logo`} onerror="this.style.display='none'" />
      <span>{shop.name}</span>
    </a>
    <nav class="nav-links">
      <a href="#services">Services</a>
      <a href="#location">Find us</a>
      <a href="#contact">Contact</a>
      <a class="button" href={shop.booksyUrl === 'Needs Lino confirmation' ? '#contact' : shop.booksyUrl} target="_blank" rel="noreferrer">Book now</a>
    </nav>
  </div>
</header>
